<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotiq_grippers_sdk_vendor</name>
  <version>1.3.0</version>
  <description>Builds the Robotiq grippers C++ SDK (github.com/robotiq/grippers) at a pinned release, for the ROS packages that use it.</description>
  <maintainer email="ros@robotiq.com">Robotiq</maintainer>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/robotiq/robotiq-ros</url>
  <url type="bugtracker">https://github.com/robotiq/robotiq-ros/issues</url>
  <url type="website">https://github.com/robotiq/grippers</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_vendor_package</buildtool_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
