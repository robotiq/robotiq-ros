<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find robotiq_description)/urdf/common.ros2_control.xacro" />

    <xacro:macro name="robotiq_gripper_ros2_control" params="
        name
        prefix
        sim_gazebo:=false
        sim_topic_based:=false
        sim_joint_commands_topic:=/sim/joint_commands
        sim_joint_states_topic:=/sim/joint_states
        use_fake_hardware:=false
        mock_sensor_commands:=false
        sim_ignition:=false
        sim_isaac:=false
        fake_sensor_commands:=false
        com_port:=/dev/ttyUSB0
        baudrate:=115200
        gripper_speed_multiplier:=1.0
        gripper_force_multiplier:=0.5
        gripper_max_speed:=0.150
        gripper_max_force:=235.0
        gripper_closed_position:=0.7929">

        <!-- PickNik's 0.0.1 names, from when this macro lived in
             robotiq_gripper.ros2_control.xacro. -->
        <xacro:if value="${sim_ignition or sim_isaac or fake_sensor_commands}">
            ${xacro.warning('sim_ignition, sim_isaac and fake_sensor_commands are deprecated since 1.4.0 and removed in the next major release; use sim_gazebo, sim_topic_based and mock_sensor_commands')}
        </xacro:if>
        <xacro:property name="use_gazebo" value="${sim_gazebo or sim_ignition}"/>
        <xacro:property name="use_topic_based" value="${sim_topic_based or sim_isaac}"/>
        <xacro:property name="commands_topic" value="${'/isaac_joint_commands' if sim_isaac else sim_joint_commands_topic}"/>
        <xacro:property name="states_topic" value="${'/isaac_joint_states' if sim_isaac else sim_joint_states_topic}"/>

        <ros2_control name="${name}" type="system">
            <!-- Plugins -->
            <xacro:robotiq_hardware
                sim_gazebo="${use_gazebo}"
                sim_topic_based="${use_topic_based}"
                sim_joint_commands_topic="${commands_topic}"
                sim_joint_states_topic="${states_topic}"
                use_fake_hardware="${use_fake_hardware}"
                mock_sensor_commands="${mock_sensor_commands or fake_sensor_commands}"
                com_port="${com_port}"
                baudrate="${baudrate}"
                gripper_speed_multiplier="${gripper_speed_multiplier}"
                gripper_force_multiplier="${gripper_force_multiplier}"
                gripper_max_speed="${gripper_max_speed}"
                gripper_max_force="${gripper_max_force}"
                gripper_closed_position="${gripper_closed_position}"
                gripper_profile="2f_85"/>

            <!-- Joint interfaces -->
            <!-- With Gazebo or Hardware, they handle mimic joints, so we only need this command interface activated -->
            <joint name="${prefix}robotiq_85_left_knuckle_joint">
                <command_interface name="position" />
                <!-- The real hardware exports these two itself instead of from
                     the URDF, and its on_init rejects a joint declaring more than
                     one command interface. Mock
                     hardware exposes only what the URDF declares, so declare them for
                     the mock alone: without them parallel_gripper_action_controller
                     (Jazzy and newer) cannot claim max_effort_interface /
                     max_velocity_interface and never activates under
                     use_fake_hardware:=true. -->
                <xacro:if value="${use_fake_hardware}">
                    <command_interface name="set_gripper_max_velocity"/>
                    <command_interface name="set_gripper_max_effort"/>
                </xacro:if>
                <state_interface name="position">
                    <param name="initial_value">${gripper_closed_position}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <xacro:unless value="${use_fake_hardware or use_gazebo or use_topic_based}">
                    <state_interface name="motor_current"/>
                    <state_interface name="object_status"/>
                    <state_interface name="gripper_fault"/>
                    <state_interface name="gripper_fault_severity"/>
                </xacro:unless>
            </joint>
            <!-- When simulating we need to include the rest of the gripper joints -->
            <xacro:if value="${use_topic_based or use_gazebo}">
                <xacro:robotiq_sim_mimic_joint name="${prefix}robotiq_85_right_knuckle_joint" sim_gazebo="${use_gazebo}"/>
                <xacro:robotiq_sim_mimic_joint name="${prefix}robotiq_85_left_inner_knuckle_joint" sim_gazebo="${use_gazebo}"/>
                <xacro:robotiq_sim_mimic_joint name="${prefix}robotiq_85_right_inner_knuckle_joint" sim_gazebo="${use_gazebo}"/>
                <xacro:robotiq_sim_mimic_joint name="${prefix}robotiq_85_left_finger_tip_joint" sim_gazebo="${use_gazebo}"/>
                <xacro:robotiq_sim_mimic_joint name="${prefix}robotiq_85_right_finger_tip_joint" sim_gazebo="${use_gazebo}"/>
            </xacro:if>

            <!-- Only add this with fake hardware mode -->
            <xacro:unless value="${use_gazebo or use_topic_based}">
                <gpio name="${prefix}reactivate_gripper">
                    <command_interface name="reactivate_gripper_cmd" />
                    <command_interface name="reactivate_gripper_response" />
                </gpio>
            </xacro:unless>

        </ros2_control>
    </xacro:macro>

</robot>
