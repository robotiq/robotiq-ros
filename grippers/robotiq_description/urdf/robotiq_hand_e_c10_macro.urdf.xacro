<?xml version="1.0"?>
<!-- Robotiq Hand-E C10: three concentric fingers, 120 degrees apart, that slide radially toward the gripper axis.

     A description without control support: links, joints, meshes and inertia, for visualization, planning and
     URDF-importing simulators. There is no <ros2_control> block, so there is no driver, mock or simulated control
     yet (hardware support is tracked in #150); the hardware arguments below are accepted, so the shared
     robotiq_gripper.urdf.xacro can instantiate it with gripper_model:=hand_e_c10, and ignored.

     Frame: origin on the gripper axis at the mounting flange (the back face of the housing), +Z toward the
     fingertips, finger 1 along +X, finger 2 at +120 degrees and finger 3 at +240 degrees about Z.

     Source: meshes, masses and the 19.2 mm finger travel come from Robotiq's ROBOTIQ_HAND-E_C10_DEFEATURE CAD
     (open and closed assemblies). Datasheet: stroke 40 mm (diameter), grip force 25-175 N per finger, closing
     speed 14-107 mm/s, weight 1.7 kg.

     Mass: 1.7 kg is the manual's "Weight (with coupling)" of 1695 g, which includes the coupling (GRP-CPL-062), fasteners
     and stepped fingers. The description has no coupling link and its frame starts at the housing, so the coupling's
     mass is lumped into the base link (the product sheet's 1.5 kg is presumably without it).

     Inertia: base and finger inertias are the CAD solids' about each link's own centre of mass. The manual's matrix
     (fig. 5-2, fingers open, Izz = 5310.7 kg.mm2) is for another configuration: it adds the coupling, the three finger
     extenders (+180 g, TCP 8 mm further out) and the stop plate with its spacers, none of which is modelled here, and
     its Ixx and Iyy (about 22 000 kg.mm2) look to be about a point far from the centre of mass, such as the flange. This description's assembly Izz is lower (about
     2060 kg.mm2); the difference has not been reconciled. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotiq_gripper">
    <xacro:macro name="robotiq_gripper" params="
        name
        prefix
        parent
        *origin
        sim_gazebo:=false
        sim_topic_based:=false
        sim_joint_commands_topic:=/sim/joint_commands
        sim_joint_states_topic:=/sim/joint_states
        sim_isaac:=false
        isaac_joint_commands:=''
        isaac_joint_states:=''
        use_fake_hardware:=false
        mock_sensor_commands:=false
        include_ros2_control:=false
        com_port:=/dev/ttyUSB0
        baudrate:=115200
        gripper_speed_multiplier:=1.0
        gripper_force_multiplier:=0.5
        tcp_z_offset:=0.15477">

        <xacro:if value="${include_ros2_control}">
            ${xacro.warning('the Hand-E C10 description has no ros2_control block yet; include_ros2_control is ignored')}
        </xacro:if>

        <!-- One finger's radial travel, 0 open to fully closed (CAD: the fingers go from 51.3 mm to 32.1 mm from the
             axis, so the diameter between the fingertips changes by 38.5 mm; the datasheet quotes 40 mm). -->
        <xacro:property name="travel" value="0.0192"/>
        <!-- The datasheet's closing speed is the diameter's, so each finger moves at half of it. -->
        <xacro:property name="finger_speed" value="0.0535"/>
        <!-- Datasheet maximum grip force, per finger. -->
        <xacro:property name="finger_effort" value="175.0"/>

        <link name="${prefix}hand_e_c10_base_link">
            <inertial>
                <origin xyz="0.00002 0.00004 0.06597" rpy="0 0 0" />
                <mass value="1.56101" />
                <inertia ixx="2828.125E-6" ixy="-0.155E-6" ixz="-1.76E-6" iyy="2810.678E-6" iyz="2.42E-6" izz="1737.434E-6" />
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/visual/hand_e_c10/base.stl" />
                </geometry>
                <material name="">
                    <color rgba="0.1 0.1 0.1 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/collision/hand_e_c10/base_housing.stl" />
                </geometry>
            </collision>
            <collision>
                <geometry>
                    <mesh filename="package://robotiq_description/meshes/collision/hand_e_c10/base_front.stl" />
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}robotiq_hande_c10_base_joint" type="fixed">
            <parent link="${parent}" />
            <child link="${prefix}hand_e_c10_base_link" />
            <xacro:insert_block name="origin" />
        </joint>

        <!-- Each finger link sits in the base frame turned about Z, so the three share one mesh, modelled open and
             pointing along +X; a joint position is that finger's travel toward the axis. -->
        <xacro:macro name="hande_c10_finger" params="index angle mimic:=''">
            <link name="${prefix}hande_c10_finger_${index}">
                <inertial>
                    <origin xyz="0.04622 -0.00002 0.1214" rpy="0 0 0" />
                    <mass value="0.04633" />
                    <inertia ixx="8.465E-6" ixy="-0.05E-6" ixz="-4.791E-6" iyy="15.191E-6" iyz="-0.009E-6" izz="8.366E-6" />
                </inertial>
                <visual>
                    <geometry>
                        <mesh filename="package://robotiq_description/meshes/visual/hand_e_c10/finger.stl" />
                    </geometry>
                    <material name="">
                        <color rgba="0.7 0.7 0.7 1" />
                    </material>
                </visual>
                <collision>
                    <geometry>
                        <mesh filename="package://robotiq_description/meshes/collision/hand_e_c10/finger_slider.stl" />
                    </geometry>
                </collision>
                <collision>
                    <geometry>
                        <mesh filename="package://robotiq_description/meshes/collision/hand_e_c10/finger_tip.stl" />
                    </geometry>
                </collision>
            </link>
            <joint name="${prefix}hande_c10_finger_${index}_joint" type="prismatic">
                <parent link="${prefix}hand_e_c10_base_link" />
                <child link="${prefix}hande_c10_finger_${index}" />
                <axis xyz="-1 0 0" />
                <origin xyz="0 0 0" rpy="0 0 ${angle}" />
                <limit lower="0.0" upper="${travel}" velocity="${finger_speed}" effort="${finger_effort}" />
                <xacro:if value="${mimic != ''}">
                    <mimic joint="${prefix}${mimic}" />
                </xacro:if>
            </joint>
        </xacro:macro>

        <xacro:hande_c10_finger index="1" angle="0" />
        <xacro:hande_c10_finger index="2" angle="${2*pi/3}" mimic="hande_c10_finger_1_joint" />
        <xacro:hande_c10_finger index="3" angle="${4*pi/3}" mimic="hande_c10_finger_1_joint" />

        <!-- The manual's TCP (5.1.2): on the axis "at the top of the larger diameter finger step", the end of the stepped
             tip, 154.77 mm from the housing's back face in the CAD. The manual measures it 165.75 mm from the robot flange,
             coupling included, which puts the coupling stack at about 11 mm; this frame excludes the coupling. -->
        <link name="${prefix}tcp_link" />
        <joint name="${prefix}tcp_link_joint" type="fixed">
            <parent link="${prefix}hand_e_c10_base_link" />
            <child link="${prefix}tcp_link" />
            <origin xyz="0 0 ${tcp_z_offset}" rpy="0 0 0" />
        </joint>
    </xacro:macro>
</robot>
