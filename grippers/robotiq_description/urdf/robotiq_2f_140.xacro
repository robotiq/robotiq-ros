<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Every link frame is parallel to robotiq_140_base_link, at the pivot
       that drives it, and each pad frame sits at the centre of its pad's
       contact face. The linkage is a parallelogram, so the inner fingers stay
       parallel to the base as finger_joint closes them. -->

  <xacro:macro name="finger_link" params="prefix name mesh mass com inertia_rpy ixx iyy izz">
    <link name="${prefix}${name}">
      <inertial>
        <origin xyz="${com}" rpy="${inertia_rpy}" />
        <mass value="${mass}" />
        <inertia ixx="${ixx}" ixy="0" ixz="0" iyy="${iyy}" iyz="0" izz="${izz}" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://robotiq_description/meshes/visual/2f_140/robotiq_2f_140_${mesh}.dae" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://robotiq_description/meshes/collision/2f_140/robotiq_2f_140_${mesh}.stl" />
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="finger_links" params="prefix fingerprefix">
    <xacro:if value="${fingerprefix == 'left'}">
      <xacro:finger_link prefix="${prefix}" name="left_outer_knuckle" mesh="outer_knuckle_left" mass="0.009163" com="0 -0.022293 -0.001722"
          inertia_rpy="0 0 0" ixx="2.13107e-07" iyy="6.73439e-07" izz="7.51601e-07"/>
      <xacro:finger_link prefix="${prefix}" name="left_outer_finger" mesh="outer_finger_left" mass="0.077064" com="3e-06 -0.014682 0.034201"
          inertia_rpy="3.14159 1.05676 1.5708" ixx="6.81569e-06" iyy="5.35424e-05" izz="5.75694e-05"/>
      <xacro:finger_link prefix="${prefix}" name="left_inner_knuckle" mesh="inner_knuckle_left" mass="0.068112" com="0 -0.035558 0.039592"
          inertia_rpy="-0.00886572 0.869353 1.56982" ixx="7.31063e-06" iyy="4.53843e-05" izz="5.10923e-05"/>
      <xacro:finger_link prefix="${prefix}" name="left_inner_finger" mesh="inner_finger_left" mass="0.049834" com="-1e-06 0.015976 0.031861"
          inertia_rpy="1.56551 -1.35441 1.57439" ixx="3.0511e-06" iyy="1.91144e-05" izz="1.71297e-05"/>
      <xacro:finger_link prefix="${prefix}" name="left_inner_finger_pad" mesh="inner_finger_pad_left" mass="0.04" com="0 -0.00961248 4.59924e-05"
          inertia_rpy="0 0 0" ixx="1.53e-05" iyy="3.6e-06" izz="1.65e-05"/>
    </xacro:if>
    <xacro:if value="${fingerprefix == 'right'}">
      <xacro:finger_link prefix="${prefix}" name="right_outer_knuckle" mesh="outer_knuckle_right" mass="0.009163" com="0 0.022293 -0.001722"
          inertia_rpy="0 0 0" ixx="2.13107e-07" iyy="6.73439e-07" izz="7.51601e-07"/>
      <xacro:finger_link prefix="${prefix}" name="right_outer_finger" mesh="outer_finger_right" mass="0.077064" com="-3e-06 0.014682 0.034201"
          inertia_rpy="3.14159 1.05676 -1.5708" ixx="6.81569e-06" iyy="5.35424e-05" izz="5.75694e-05"/>
      <xacro:finger_link prefix="${prefix}" name="right_inner_knuckle" mesh="inner_knuckle_right" mass="0.068112" com="0 0.035558 0.039592"
          inertia_rpy="-0.00886572 0.869353 -1.57178" ixx="7.31063e-06" iyy="4.53843e-05" izz="5.10923e-05"/>
      <xacro:finger_link prefix="${prefix}" name="right_inner_finger" mesh="inner_finger_right" mass="0.049834" com="-1e-06 -0.015979 0.031859"
          inertia_rpy="-1.56555 -1.35441 -1.57749" ixx="3.0511e-06" iyy="1.91144e-05" izz="1.71297e-05"/>
      <xacro:finger_link prefix="${prefix}" name="right_inner_finger_pad" mesh="inner_finger_pad_right" mass="0.04" com="0.0002 0.0095875 -4.13805e-05"
          inertia_rpy="0 0 0" ixx="1.53e-05" iyy="3.6e-06" izz="1.65e-05"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="finger_joint" params="prefix">
    <joint name="${prefix}finger_joint" type="revolute">
      <origin xyz="0 -0.030601 0.054663" rpy="0 0 0" />
      <parent link="${prefix}robotiq_140_base_link" />
      <child link="${prefix}left_outer_knuckle" />
      <axis xyz="-1 0 0" />
      <limit lower="0" upper="0.785" velocity="2.0" effort="1000" />
    </joint>
    <joint name="${prefix}left_outer_finger_joint" type="fixed">
      <origin xyz="0 -0.031425 -0.004533" rpy="0 0 0" />
      <parent link="${prefix}left_outer_knuckle" />
      <child link="${prefix}left_outer_finger" />
    </joint>
    <joint name="${prefix}left_inner_knuckle_joint" type="revolute">
      <origin xyz="0 -0.0127 0.061178" rpy="0 0 0" />
      <parent link="${prefix}robotiq_140_base_link" />
      <child link="${prefix}left_inner_knuckle" />
      <axis xyz="-1 0 0" />
      <limit lower="0" upper="0.785" velocity="2.0" effort="1000" />
      <mimic joint="${prefix}finger_joint" multiplier="1" offset="0" />
    </joint>
    <joint name="${prefix}left_inner_finger_joint" type="revolute">
      <origin xyz="0 -0.03543 0.078899" rpy="0 0 0" />
      <parent link="${prefix}left_outer_finger" />
      <child link="${prefix}left_inner_finger" />
      <axis xyz="-1 0 0" />
      <limit lower="-0.785" upper="0" velocity="2.0" effort="1000" />
      <mimic joint="${prefix}finger_joint" multiplier="-1" offset="0" />
    </joint>
    <joint name="${prefix}left_inner_finger_pad_joint" type="fixed">
      <origin xyz="0 0.0271685 0.047725" rpy="0 0 0" />
      <parent link="${prefix}left_inner_finger" />
      <child link="${prefix}left_inner_finger_pad" />
    </joint>
  </xacro:macro>

  <xacro:macro name="right_outer_knuckle_joint" params="prefix">
    <joint name="${prefix}right_outer_knuckle_joint" type="revolute">
      <origin xyz="0 0.030601 0.054663" rpy="0 0 0" />
      <parent link="${prefix}robotiq_140_base_link" />
      <child link="${prefix}right_outer_knuckle" />
      <axis xyz="1 0 0" />
      <limit lower="0" upper="0.785" velocity="2.0" effort="1000" />
      <mimic joint="${prefix}finger_joint" multiplier="1" offset="0" />
    </joint>
    <joint name="${prefix}right_outer_finger_joint" type="fixed">
      <origin xyz="0 0.031425 -0.004533" rpy="0 0 0" />
      <parent link="${prefix}right_outer_knuckle" />
      <child link="${prefix}right_outer_finger" />
    </joint>
    <joint name="${prefix}right_inner_knuckle_joint" type="revolute">
      <origin xyz="0 0.0127 0.061178" rpy="0 0 0" />
      <parent link="${prefix}robotiq_140_base_link" />
      <child link="${prefix}right_inner_knuckle" />
      <axis xyz="1 0 0" />
      <limit lower="0" upper="0.785" velocity="2.0" effort="1000" />
      <mimic joint="${prefix}finger_joint" multiplier="1" offset="0" />
    </joint>
    <joint name="${prefix}right_inner_finger_joint" type="revolute">
      <origin xyz="0 0.03543 0.078899" rpy="0 0 0" />
      <parent link="${prefix}right_outer_finger" />
      <child link="${prefix}right_inner_finger" />
      <axis xyz="1 0 0" />
      <limit lower="-0.785" upper="0" velocity="2.0" effort="1000" />
      <mimic joint="${prefix}finger_joint" multiplier="-1" offset="0" />
    </joint>
    <joint name="${prefix}right_inner_finger_pad_joint" type="fixed">
      <origin xyz="-0.0002 -0.0277435 0.0482124" rpy="0 0 0" />
      <parent link="${prefix}right_inner_finger" />
      <child link="${prefix}right_inner_finger_pad" />
    </joint>
  </xacro:macro>
</robot>
