<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotiq_test_support</name>
  <version>1.3.0</version>
  <description>Shared gtest main for the test suites that create nodes.</description>
  <maintainer email="noreply@robotiq.com">Robotiq</maintainer>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/robotiq/robotiq-ros</url>
  <url type="bugtracker">https://github.com/robotiq/robotiq-ros/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_gtest</buildtool_depend>
  <buildtool_export_depend>ament_cmake_gtest</buildtool_export_depend>

  <depend>rclcpp</depend>
  <depend>rcpputils</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
